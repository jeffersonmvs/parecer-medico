# PostgreSQL connection (Supabase, Neon, RDS, etc.).
# For Supabase use the Transaction pooler (port 6543) and keep the app's
# tables isolated in a dedicated schema.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?schema=parecer&pgbouncer=true&connection_limit=1"

# Secret used to sign session JWTs. Use a long random value in production.
JWT_SECRET="change-me-to-a-long-random-string"
